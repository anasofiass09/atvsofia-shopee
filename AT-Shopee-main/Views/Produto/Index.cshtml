@model IEnumerable<ShopeeMVC.Models.Produto>

@{
    ViewData["Title"] = "Produtos";
}

<h1>Produtos</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Criar Novo</a>
</p>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Nome)</th>
            <th>@Html.DisplayNameFor(model => model.Preco)</th>
            <th>@Html.DisplayNameFor(model => model.Estoque)</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Nome)</td>
                <td>@item.Preco.ToString("C")</td>
                <td>@Html.DisplayFor(modelItem => item.Estoque)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Codigo" class="btn btn-sm btn-outline-primary">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.Codigo" class="btn btn-sm btn-outline-info">Detalhes</a> |
                    <a asp-action="Delete" asp-route-id="@item.Codigo" class="btn btn-sm btn-outline-danger">Excluir</a> |
                    <a asp-controller="Carrinho"
                       asp-action="Adicionar"
                       asp-route-id="@item.Codigo"
                       class="btn btn-sm btn-primary">
                        Adicionar ao carrinho
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>